POSTMASTER_DATA=/var/lib/postmaster
PUBLIC_URL=https://mail.example.com
# Keep secure cookies enabled in production. Set to 1 only for localhost HTTP.
POSTMASTER_INSECURE=0
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Hosted wallet funding. Enable only with a matching signed webhook.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
